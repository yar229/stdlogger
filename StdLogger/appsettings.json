{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore.Mvc": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "log-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "StdLogger": {
    "LevelPatterns": [
      { "Level": "Fatal", "Pattern": "\\]? FATAL (\\s*\\w{2}\\d+)? (\\]|\\:)" },
      { "Level": "Fatal", "Pattern": "\\]? CRITICAL (\\s*\\w{2}\\d+)? (\\]|\\:)" },
      { "Level": "Error", "Pattern": "\\]? ERROR (\\s*\\w{2}\\d+)? (\\]|\\:)" },
      { "Level": "Warning", "Pattern": "\\]? WARN(?:ING)? (\\s*\\w{2}\\d+)? (\\]|\\:)" },
      { "Level": "Information", "Pattern": "\\]? INFO (\\s*\\w{2}\\d+)? (\\]|\\:)" },
      { "Level": "Debug", "Pattern": "\\]? DEBUG (\\s*\\w{2}\\d+)? (\\]|\\:)" },
      { "Level": "Trace", "Pattern": "\\]? TRACE (\\s*\\w{2}\\d+)? (\\]|\\:)" }
    ]
  }
}